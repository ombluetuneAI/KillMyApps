    <string name="shizuku_guide_body_ready">Privilege service is running. You can kill apps from the list.</string>
    <string name="shizuku_guide_title_root">Root engine</string>
    <string name="shizuku_guide_body_root">Current engine is Root. Switch to Built-in (ADB) in Settings for the no-Shizuku path.</string>

